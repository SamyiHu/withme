# WithMe 环境变量模板。复制为 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不入库。

# 主 LLM key（OpenAI 兼容端点；mock provider 不需要）
LLM_API_KEY=sk-xxx

# 可选：覆盖 config.yaml 的 llm 段（不改配置文件切真实模型）
# AGENT_LLM_PROVIDER=openai_compatible
# AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_LLM_MODEL=glm-4-flash

# 智谱开放平台 key：ASR 语音识别 / Web Search Pro / CogView 画图共用
# BIGMODEL_API_KEY=xxx

# 可选：服务端访问令牌（对外部署时必开，见 deploy/withme.service）
# AGENT_API_TOKEN=please-change-me
